# ===== Cấu hình mẫu biến môi trường Backend Express.js (ITJobs) =====
# Sao chép file này thành .env và điền giá trị thực tế

# Cổng chạy server
PORT=4000

# development | production
NODE_ENV=production

# Chuỗi kết nối MongoDB Atlas
DATABASE=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# Khóa bí mật ký JWT - bắt buộc trùng khớp với JWT_SECRET bên Frontend
JWT_SECRET=thay_bang_chuoi_ngau_nhien_dai_it_nhat_32_ky_tu

# Domain Frontend được phép gọi API (cách nhau bởi dấu phẩy nếu có nhiều domain)
CORS_ORIGIN=https://devjobs.click,https://www.devjobs.click

# Cloudinary lưu trữ ảnh công ty và avatar
cloud_name=your_cloud_name
api_key_image=your_api_key
api_secret_image=your_api_secret
